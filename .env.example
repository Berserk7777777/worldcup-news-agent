SILICONFLOW_API_KEY=your_siliconflow_api_key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# 请根据硅基流动当前可用模型列表填写模型ID
PLANNER_MODEL=deepseek-ai/DeepSeek-V4-Flash
WRITER_MODEL=deepseek-ai/DeepSeek-V4-Flash
REVIEWER_MODEL=Qwen/Qwen3-VL-32B-Instruct
IMAGE_MODEL=Tongyi-MAI/Z-Image-Turbo
IMAGE_PROVIDER=ttapi
CHAT_MODEL=Qwen/Qwen3.5-9B
# Structured news tasks disable reasoning by default to reduce latency.
SILICONFLOW_ENABLE_THINKING=false
VISION_MODEL=Qwen/Qwen3-VL-32B-Instruct
ASR_MODEL=FunAudioLLM/SenseVoiceSmall
TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
TTS_VOICE=FunAudioLLM/CosyVoice2-0.5B:alex
EMBEDDING_MODEL=BAAI/bge-m3

# 可选配置
IMAGE_SIZE=1024x1024
REQUEST_TIMEOUT=1200

# 在 TTAPI 控制台创建只授权 MIDJOURNEY-IMAGE 的独立 Key
TTAPI_IMAGE_API_KEY=your_ttapi_midjourney_image_key
TTAPI_IMAGE_BASE_URL=https://api.ttapi.io
TTAPI_IMAGE_API_KEY_HEADER=TT-API-KEY
TTAPI_GET_U_IMAGES=false
TTAPI_IMAGINE_PATH=/midjourney/v1/imagine
TTAPI_FETCH_PATH=/midjourney/v1/fetch
TTAPI_ACTION_PATH=/midjourney/v1/action
TTAPI_FETCH_METHOD=GET
TTAPI_ACTION_FIELD=action
TTAPI_REQUEST_TIMEOUT_SECONDS=30
TTAPI_POLL_INTERVAL_SECONDS=5
TTAPI_POLL_TIMEOUT_SECONDS=600
